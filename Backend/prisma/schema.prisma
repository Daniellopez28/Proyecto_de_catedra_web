// CORRECCIÓN: esquema Prisma alineado con las tablas, nombres y relaciones usados por la API.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model roles {
  id_rol            Int             @id @default(autoincrement())
  nombre_rol        String          @unique @db.VarChar(50)
  descripcion       String?         @db.VarChar(Max)
  es_administrativo Boolean         @default(false)
  pantalla_inicio   String          @default("panel_principal") @db.VarChar(50)
  id_nivel          Int
  niveles_acceso    niveles_acceso  @relation(fields: [id_nivel], references: [id_nivel], onUpdate: NoAction)
  usuarios          usuarios[]
  empleados         empleados[]
}

model sucursales {
  sucursalid             Int                    @id @default(autoincrement())
  nombre                 String                 @unique @db.VarChar(100)
  direccion              String                 @db.VarChar(255)
  telefono               String?                @db.VarChar(20)
  activo                 Boolean                @default(true)
  empleados              empleados[]
  usuarios               usuarios[]
  inventario_sucursal    inventario_sucursal[]
  movimientos_inventario movimientos_inventario[]
  mesas                  mesas[]
  ventas                 ventas[]
  cajas                  cajas[]
  compras                compras[]
}

model empleados {
  id_empleado      Int                @id @default(autoincrement())
  codigo_empleado  String             @unique @db.VarChar(12)
  sucursalid       Int?
  id_rol           Int
  nombres          String             @db.VarChar(100)
  apellido_paterno String             @db.VarChar(50)
  apellido_materno String?            @db.VarChar(50)
  nombre_completo  String             @db.VarChar(250)
  dui              String             @unique @db.VarChar(10)
  fecha_nacimiento DateTime           @db.Date
  isss_numero      String?            @db.VarChar(15)
  afp_numero       String?            @db.VarChar(20)
  cargo            String             @db.VarChar(50)
  tipo_planilla    String             @db.VarChar(20)
  salario_base     Decimal            @db.Decimal(10, 2)
  activo           Boolean            @default(true)
  fecha_ingreso    DateTime           @db.Date
  correo           String?            @db.VarChar(150)
  tipo_contrato    String?            @db.VarChar(50)
  jornada          String?            @db.VarChar(50)
  forma_pago       String?            @db.VarChar(50)
  sucursales       sucursales?        @relation(fields: [sucursalid], references: [sucursalid], onDelete: NoAction, onUpdate: NoAction)
  roles            roles              @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  usuarios         usuarios[]
  planilla_detalle planilla_detalle[]
}

model usuarios {
  id_usuario            Int        @id @default(autoincrement())
  id_rol                Int
  sucursalid            Int?
  id_empleado           Int?
  id_cliente            Int?
  nombre_completo       String     @db.VarChar(150)
  correo                String     @unique @db.VarChar(150)
  password_hash         String     @db.VarChar(255)
  password_salt         String?    @db.VarChar(32)
  debe_cambiar_password Boolean    @default(true)
  ultimo_acceso         DateTime?  @db.DateTime
  activo                Boolean    @default(true)
  creado_en             DateTime   @default(now()) @db.DateTime
  roles                 roles      @relation(fields: [id_rol], references: [id_rol], onUpdate: NoAction)
  sucursales            sucursales? @relation(fields: [sucursalid], references: [sucursalid], onDelete: NoAction, onUpdate: NoAction)
  empleados             empleados? @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction)
  clientes              clientes?  @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  cajas                 cajas[]
  ventas                ventas[]
  movimientos_inventario movimientos_inventario[]
  pagos_compra          pagos_compra[]
}

model planillas {
  id_planilla      Int                @id @default(autoincrement())
  periodo_inicio   DateTime           @db.Date
  periodo_fin      DateTime           @db.Date
  tipo_planilla    String             @db.VarChar(20)
  total_pagar      Decimal            @db.Decimal(10, 2)
  estado           String?            @default("generada") @db.VarChar(20)
  planilla_detalle planilla_detalle[]
}

model planilla_detalle {
  id_planilla     Int
  id_empleado     Int
  salario_bruto   Decimal   @db.Decimal(10, 2)
  descuento_isss  Decimal   @db.Decimal(10, 2)
  descuento_afp   Decimal   @db.Decimal(10, 2)
  descuento_renta Decimal   @db.Decimal(10, 2)
  salario_neto    Decimal   @db.Decimal(10, 2)
  planillas       planillas @relation(fields: [id_planilla], references: [id_planilla], onDelete: Cascade, onUpdate: NoAction)
  empleados       empleados @relation(fields: [id_empleado], references: [id_empleado], onUpdate: NoAction)

  @@id([id_planilla, id_empleado])
}

model clientes {
  id_cliente       Int        @id @default(autoincrement())
  nombre           String     @db.VarChar(150)
  dui              String?    @db.VarChar(10)
  nit              String?    @db.VarChar(17)
  nrc              String?    @db.VarChar(15)
  telefono         String?    @db.VarChar(20)
  correo           String?    @db.VarChar(150)
  direccion        String?    @db.VarChar(Max)
  giro             String?    @db.VarChar(150)
  direccion_fiscal String?    @db.VarChar(255)
  creado_en        DateTime?  @default(now()) @db.DateTime
  usuarios         usuarios[]
  ventas           ventas[]
  reservas         reservas[]
}

model proveedores {
  id_proveedor    Int       @id @default(autoincrement())
  nombre_empresa  String    @db.VarChar(150)
  contacto_nombre String?   @db.VarChar(100)
  nit             String?   @db.VarChar(17)
  telefono        String?   @db.VarChar(20)
  correo          String?   @db.VarChar(150)
  direccion       String?   @db.VarChar(Max)
  activo          Boolean?  @default(true)
  compras         compras[]
}

model insumos {
  id_insumo              Int                    @id @default(autoincrement())
  nombre                 String                 @unique @db.VarChar(100)
  unidad_medida          String                 @db.VarChar(20)
  stock_actual           Decimal?               @default(0) @db.Decimal(10, 2)
  stock_minimo           Decimal?               @default(0) @db.Decimal(10, 2)
  costo_promedio         Decimal?               @default(0) @db.Decimal(10, 4)
  activo                 Boolean?               @default(true)
  compra_detalle         compra_detalle[]
  recetas_detalle        recetas_detalle[]
  inventario_sucursal    inventario_sucursal[]
  movimientos_inventario movimientos_inventario[]
}

model productos {
  id_producto     Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(150)
  descripcion     String?           @db.VarChar(Max)
  precio_venta    Decimal           @db.Decimal(10, 2)
  categoria       String?           @db.VarChar(50)
  es_reventa      Boolean?          @default(false)
  activo          Boolean?          @default(true)
  stock_actual    Decimal?          @default(0) @db.Decimal(10, 2)
  recetas_detalle recetas_detalle[]
  venta_detalle   venta_detalle[]
}

model recetas_detalle {
  id_producto        Int
  id_insumo          Int
  cantidad_requerida Decimal   @db.Decimal(10, 2)
  productos          productos @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade, onUpdate: NoAction)
  insumos            insumos   @relation(fields: [id_insumo], references: [id_insumo], onUpdate: NoAction)

  @@id([id_producto, id_insumo])
}

model inventario_sucursal {
  inventarioid Int        @id @default(autoincrement())
  sucursalid   Int
  insumoid     Int
  stock_actual Decimal    @default(0) @db.Decimal(10, 2)
  stock_minimo Decimal    @default(0) @db.Decimal(10, 2)
  sucursales   sucursales @relation(fields: [sucursalid], references: [sucursalid], onUpdate: NoAction)
  insumos      insumos    @relation(fields: [insumoid], references: [id_insumo], onUpdate: NoAction)

  @@unique([sucursalid, insumoid])
}

model movimientos_inventario {
  movimientoid    BigInt     @id @default(autoincrement())
  sucursalid      Int
  insumoid        Int
  tipo_movimiento String     @db.VarChar(20)
  cantidad        Decimal    @db.Decimal(10, 2)
  referencia      String?    @db.VarChar(100)
  fecha           DateTime   @default(now()) @db.DateTime2
  id_usuario      Int?
  sucursales      sucursales @relation(fields: [sucursalid], references: [sucursalid], onDelete: NoAction, onUpdate: NoAction)
  insumos         insumos    @relation(fields: [insumoid], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  usuarios        usuarios?  @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model mesas {
  mesaid       Int        @id @default(autoincrement())
  sucursalid   Int
  numero_mesa  String     @db.VarChar(20)
  capacidad    Int
  estado       String     @default("libre") @db.VarChar(20)
  sucursales   sucursales @relation(fields: [sucursalid], references: [sucursalid], onUpdate: NoAction)
  ventas       ventas[]
  reservas     reservas[]

  @@unique([sucursalid, numero_mesa])
}

model modificadores {
  modificadorid Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(100)
  precio        Decimal  @db.Decimal(10, 2)
  activo        Boolean  @default(true)
}

model ventas {
  id_venta       Int             @id @default(autoincrement())
  id_cliente     Int?
  id_usuario     Int
  sucursalid     Int?
  mesaid         Int?
  fecha_hora     DateTime?       @default(now()) @db.DateTime
  tipo_documento String          @db.VarChar(30)
  correlativo    String          @unique @db.VarChar(50)
  subtotal       Decimal         @db.Decimal(10, 2)
  iva            Decimal         @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  descuento      Decimal         @default(0) @db.Decimal(10, 2)
  estado         String?         @default("pagada") @db.VarChar(20)
  estado_pedido  String?         @default("pagado") @db.VarChar(30)
  notas_generales String?        @db.VarChar(255)
  clientes       clientes?       @relation(fields: [id_cliente], references: [id_cliente], onDelete: SetNull, onUpdate: NoAction)
  usuarios       usuarios        @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)
  sucursales     sucursales?     @relation(fields: [sucursalid], references: [sucursalid], onUpdate: NoAction)
  mesas          mesas?          @relation(fields: [mesaid], references: [mesaid], onUpdate: NoAction)
  venta_detalle  venta_detalle[]
  pagos          pagos[]
}

model venta_detalle {
  id_venta        Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal_linea  Decimal   @db.Decimal(10, 2)
  notas           String?   @db.VarChar(255)
  ventas          ventas    @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade, onUpdate: NoAction)
  productos       productos @relation(fields: [id_producto], references: [id_producto], onUpdate: NoAction)

  @@id([id_venta, id_producto])
}

model detalle_venta_modificadores {
  detalle_modificadoid Int      @id @default(autoincrement())
  id_venta             Int
  id_producto          Int
  modificadorid        Int
  precio_aplicado      Decimal  @db.Decimal(10, 2)
}

model pagos {
  id_pagos               Int       @id @default(autoincrement())
  id_venta               Int
  metodo_pago            String    @db.VarChar(50)
  monto                  Decimal   @db.Decimal(10, 2)
  referencia_transaccion String?   @db.VarChar(100)
  fecha_pago             DateTime? @default(now()) @db.DateTime
  ventas                 ventas    @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade, onUpdate: NoAction)
}

model cajas {
  id_caja                Int       @id @default(autoincrement())
  id_usuario             Int
  sucursalid             Int?
  nombre_caja            String?   @db.VarChar(50)
  fecha_apertura         DateTime? @default(now()) @db.DateTime
  fecha_cierre           DateTime? @db.DateTime
  monto_apertura         Decimal   @db.Decimal(10, 2)
  monto_cierre_sistema   Decimal?  @db.Decimal(10, 2)
  monto_cierre_fisico    Decimal?  @db.Decimal(10, 2)
  diferencia             Decimal?  @db.Decimal(10, 2)
  estado                 String?   @default("abierta") @db.VarChar(20)
  observaciones_apertura String?   @db.VarChar(255)
  observaciones_cierre   String?   @db.VarChar(255)
  empleado_autoriza_id   Int?
  usuarios               usuarios @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)
  sucursales             sucursales? @relation(fields: [sucursalid], references: [sucursalid], onUpdate: NoAction)
  movimientos_caja       movimientos_caja[]
}

model movimientos_caja {
  movimientocajaid     BigInt   @id @default(autoincrement())
  cajaid               Int
  tipo_movimiento      String   @db.VarChar(30)
  monto                Decimal  @db.Decimal(10, 2)
  motivo               String?  @db.VarChar(255)
  empleado_autoriza_id Int?
  fecha                DateTime @default(now()) @db.DateTime2
  cajas                cajas    @relation(fields: [cajaid], references: [id_caja], onUpdate: NoAction)
}

model compras {
  id_compra                Int              @id @default(autoincrement())
  id_proveedor             Int
  sucursalid               Int?
  fecha_compra             DateTime?        @default(now()) @db.DateTime
  numero_factura_proveedor String           @db.VarChar(50)
  subtotal                 Decimal          @default(0) @db.Decimal(10, 2)
  iva                      Decimal          @default(0) @db.Decimal(10, 2)
  total_compra             Decimal          @db.Decimal(10, 2)
  estado_pago              String?          @default("pendiente") @db.VarChar(20)
  fecha_vencimiento        DateTime?        @db.Date
  condicion_pago           String?          @db.VarChar(50)
  clasificacion            String?          @db.VarChar(50)
  estado_documento         String?          @default("registrada") @db.VarChar(20)
  proveedores              proveedores      @relation(fields: [id_proveedor], references: [id_proveedor], onUpdate: NoAction)
  sucursales               sucursales?      @relation(fields: [sucursalid], references: [sucursalid], onUpdate: NoAction)
  compra_detalle           compra_detalle[]
  pagos_compra             pagos_compra[]
}

model compra_detalle {
  id_compra      Int
  id_insumo      Int
  cantidad       Decimal @db.Decimal(10, 2)
  costo_unitario Decimal @db.Decimal(10, 4)
  subtotal       Decimal @db.Decimal(10, 2)
  compras        compras @relation(fields: [id_compra], references: [id_compra], onDelete: Cascade, onUpdate: NoAction)
  insumos        insumos @relation(fields: [id_insumo], references: [id_insumo], onUpdate: NoAction)

  @@id([id_compra, id_insumo])
}

model pagos_compra {
  pagocompraid Int      @id @default(autoincrement())
  id_compra    Int
  monto        Decimal  @db.Decimal(10, 2)
  metodo_pago  String   @db.VarChar(30)
  referencia   String?  @db.VarChar(50)
  fecha        DateTime @default(now()) @db.DateTime2
  id_usuario   Int
  compras      compras  @relation(fields: [id_compra], references: [id_compra], onUpdate: NoAction)
  usuarios     usuarios @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)
}

model niveles_acceso {
  id_nivel    Int             @id @default(autoincrement())
  codigo      String          @unique @db.VarChar(20)
  descripcion String?         @db.VarChar(255)
  roles       roles[]
  permisos    nivel_permiso[]
}

model permisos {
  id_permiso  Int             @id @default(autoincrement())
  codigo      String          @unique @db.VarChar(50)
  descripcion String?         @db.VarChar(255)
  niveles     nivel_permiso[]
}

model nivel_permiso {
  id_nivel   Int
  id_permiso Int
  niveles_acceso niveles_acceso @relation(fields: [id_nivel], references: [id_nivel], onDelete: Cascade, onUpdate: NoAction)
  permisos      permisos      @relation(fields: [id_permiso], references: [id_permiso], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_nivel, id_permiso])
}

model reservas {
  id_reserva        Int      @id @default(autoincrement())
  mesaid            Int
  id_cliente        Int
  fecha_hora_inicio DateTime @db.DateTime2
  duracion_minutos  Int      @default(90)
  cantidad_personas Int
  estado            String   @default("pendiente") @db.VarChar(20)
  notas             String?  @db.VarChar(255)
  creada_en         DateTime @default(now()) @db.DateTime
  mesas             mesas    @relation(fields: [mesaid], references: [mesaid], onUpdate: NoAction)
  clientes          clientes @relation(fields: [id_cliente], references: [id_cliente], onUpdate: NoAction)
}
