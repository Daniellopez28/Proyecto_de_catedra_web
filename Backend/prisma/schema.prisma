  insumoid     Int
  stock_actual Decimal    @default(0.00, map: "df_inventario_sucursal_stock") @db.Decimal(10, 2)
  stock_minimo Decimal    @default(0.00, map: "df_inventario_sucursal_minimo") @db.Decimal(10, 2)
