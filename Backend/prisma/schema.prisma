  id_cliente             Int?                     @unique(map: "ux_usuarios_cliente", where: raw("([id_cliente] IS NOT NULL)"))
  cajas                  cajas[]
  movimientos_inventario movimientos_inventario[]
  pagos_compra           pagos_compra[]
  roles                  roles                    @relation(fields: [id_rol], references: [id_rol], onUpdate: NoAction, map: "fk_usuario_rol")
  clientes               clientes?                @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuarios_clientes")
  empleados              empleados?               @relation(fields: [id_empleado], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuarios_empleados")
  sucursales             sucursales?              @relation(fields: [sucursalid], references: [sucursalid], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuarios_sucursales")
  ventas                 ventas[]
}

