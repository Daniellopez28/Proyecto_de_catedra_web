  estado      String     @default("libre", map: "df_mesas_estado") @db.VarChar(20)
  sucursales  sucursales @relation(fields: [sucursalid], references: [sucursalid], onUpdate: NoAction, map: "fk_mesas_sucursal")
  reservas    reservas[]
  ventas      ventas[]

  @@unique([sucursalid, numero_mesa], map: "uq_mesas_sucursal_numero")
}

model modificadores {
  modificadorid               Int                           @id(map: "pk_modificadores") @default(autoincrement())
  nombre                      String                        @unique(map: "uq_modificadores_nombre") @db.VarChar(100)
  precio                      Decimal                       @db.Decimal(10, 2)
  activo                      Boolean                       @default(true, map: "df_modificadores_activo")
  detalle_venta_modificadores detalle_venta_modificadores[]
}

model movimientos_caja {
  movimientocajaid     BigInt     @id(map: "pk_movimientos_caja") @default(autoincrement())
  cajaid               Int
  tipo_movimiento      String     @db.VarChar(30)
  monto                Decimal    @db.Decimal(10, 2)
  motivo               String?    @db.VarChar(255)
  empleado_autoriza_id Int?
  fecha                DateTime   @default(dbgenerated("sysdatetime()"), map: "df_movimientos_caja_fecha")
  cajas                cajas      @relation(fields: [cajaid], references: [id_caja], onUpdate: NoAction, map: "fk_movimientos_caja_caja")
  empleados            empleados? @relation(fields: [empleado_autoriza_id], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction, map: "fk_movimientos_caja_empleado")
}

model movimientos_inventario {
  movimientoid    BigInt     @id(map: "pk_movimientos_inventario") @default(autoincrement())
  sucursalid      Int
  insumoid        Int
  tipo_movimiento String     @db.VarChar(20)
  cantidad        Decimal    @db.Decimal(10, 2)
  referencia      String?    @db.VarChar(100)
  fecha           DateTime   @default(dbgenerated("sysdatetime()"), map: "df_movimientos_inventario_fecha")
  id_usuario      Int?
  insumos         insumos    @relation(fields: [insumoid], references: [id_insumo], onUpdate: NoAction, map: "fk_movimientos_inventario_insumo")
  sucursales      sucursales @relation(fields: [sucursalid], references: [sucursalid], onUpdate: NoAction, map: "fk_movimientos_inventario_sucursal")
  usuarios        usuarios?  @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_movimientos_inventario_usuario")

  @@index([insumoid, fecha(sort: Desc)], map: "ix_movimientos_inventario_insumo_fecha")
}

model nivel_permiso {
  id_nivel       Int
  id_permiso     Int
  niveles_acceso niveles_acceso @relation(fields: [id_nivel], references: [id_nivel], onDelete: Cascade, onUpdate: NoAction, map: "fk_nivel_permiso_nivel")
  permisos       permisos       @relation(fields: [id_permiso], references: [id_permiso], onDelete: Cascade, onUpdate: NoAction, map: "fk_nivel_permiso_permiso")

  @@id([id_nivel, id_permiso], map: "pk_nivel_permiso")
}

model niveles_acceso {
  id_nivel      Int             @id(map: "pk_niveles_acceso") @default(autoincrement())
  codigo        String          @unique(map: "uq_niveles_acceso_codigo") @db.VarChar(20)
  descripcion   String?         @db.VarChar(255)
  nivel_permiso nivel_permiso[]
  roles         roles[]
}

model pagos_compra {
  pagocompraid Int      @id(map: "pk_pagos_compra") @default(autoincrement())
  id_compra    Int
  monto        Decimal  @db.Decimal(10, 2)
  metodo_pago  String   @db.VarChar(30)
  referencia   String?  @db.VarChar(50)
  fecha        DateTime @default(dbgenerated("sysdatetime()"), map: "df_pagos_compra_fecha")
  id_usuario   Int
  compras      compras  @relation(fields: [id_compra], references: [id_compra], onUpdate: NoAction, map: "fk_pagos_compra_compra")
  usuarios     usuarios @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction, map: "fk_pagos_compra_usuario")
}

model permisos {
  id_permiso    Int             @id(map: "pk_permisos") @default(autoincrement())
  codigo        String          @unique(map: "uq_permisos_codigo") @db.VarChar(50)
  descripcion   String?         @db.VarChar(255)
  nivel_permiso nivel_permiso[]
}

model reservas {
  id_reserva        Int      @id(map: "pk_reservas") @default(autoincrement())
  mesaid            Int
  id_cliente        Int
  fecha_hora_inicio DateTime
  duracion_minutos  Int      @default(90, map: "df_reservas_duracion")
