generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlserver"
}

model cajas {
  id_caja                Int                @id(map: "pk_cajas") @default(autoincrement())
  id_usuario             Int
  sucursalid             Int?               @unique(map: "ux_cajas_una_abierta_por_sucursal", where: raw("([estado]='abierta' AND [sucursalid] IS NOT NULL)"))
  nombre_caja            String?            @db.VarChar(50)
  fecha_apertura         DateTime?          @default(now(), map: "df_cajas_apertura") @db.DateTime
  fecha_cierre           DateTime?          @db.DateTime
  monto_apertura         Decimal            @db.Decimal(10, 2)
  monto_cierre_sistema   Decimal?           @db.Decimal(10, 2)
  monto_cierre_fisico    Decimal?           @db.Decimal(10, 2)
  diferencia             Decimal?           @db.Decimal(10, 2)
  estado                 String?            @default("abierta", map: "df_cajas_estado") @db.VarChar(20)
  observaciones_apertura String?            @db.VarChar(255)
  observaciones_cierre   String?            @db.VarChar(255)
  empleado_autoriza_id   Int?
  empleados              empleados?         @relation(fields: [empleado_autoriza_id], references: [id_empleado], onDelete: NoAction, onUpdate: NoAction, map: "fk_caja_autoriza")
  sucursales             sucursales?        @relation(fields: [sucursalid], references: [sucursalid], onDelete: NoAction, onUpdate: NoAction, map: "fk_caja_sucursal")
  usuarios               usuarios           @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction, map: "fk_caja_usuario")
  movimientos_caja       movimientos_caja[]
}

